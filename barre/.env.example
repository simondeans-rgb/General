# Local development against the Postgres running in this container
DATABASE_URL=postgresql://postgres@localhost:5433/barre_dev

# When deploying the static demo under a sub-path (GitHub Pages)
# NEXT_PUBLIC_BASE_PATH=/General/studio

# Which data adapter the browser should use: 'pglite' (demo) or 'supabase'
NEXT_PUBLIC_DATA_ADAPTER=pglite

# Supabase (not required for the demo; fill in to move to a hosted backend)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
