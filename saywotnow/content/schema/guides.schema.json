{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SayWotNow guides.json",
  "type": "object",
  "required": [
    "contentVersion",
    "lastReviewed",
    "guides"
  ],
  "additionalProperties": false,
  "properties": {
    "contentVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lastReviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "guides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "category",
          "flagLevel",
          "length",
          "keywords",
          "whenToUse",
          "before",
          "opening",
          "during",
          "responses",
          "donts",
          "hrTriggers",
          "after",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^G\\d{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "performance",
              "wellbeing",
              "everyday"
            ]
          },
          "flagLevel": {
            "enum": [
              1,
              2,
              3
            ]
          },
          "length": {
            "type": "string",
            "minLength": 1
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "whenToUse": {
            "type": "string",
            "minLength": 1
          },
          "urgentBanner": {
            "type": "boolean"
          },
          "before": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "opening": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "sayIt": {
            "description": "Copy-ready lines shown under \"Say it like this\" on the During tab.",
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "when",
                "line"
              ],
              "properties": {
                "when": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "during": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "responses": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "theySay",
                "youCould"
              ],
              "properties": {
                "theySay": {
                  "type": "string",
                  "minLength": 1
                },
                "youCould": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "donts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "hrTriggers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "after": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "summary": {
            "type": "object",
            "required": [
              "topic",
              "prompt",
              "recommended"
            ],
            "additionalProperties": false,
            "properties": {
              "notice": {
                "type": "string",
                "minLength": 1
              },
              "topic": {
                "type": "string",
                "minLength": 1
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "recommended": {
                "type": "boolean"
              },
              "formNote": {
                "type": "string",
                "minLength": 1
              },
              "short": {
                "type": "boolean"
              }
            }
          },
          "escalation": {
            "description": "HR-first gate for Level 3 guides (P0.3). Shown above all scripts and checklists; never hidden by the user's answers.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reviewStatus",
              "headline",
              "stop",
              "triageIntro",
              "triage",
              "ifYes",
              "ifNo",
              "holdingIntro",
              "holding"
            ],
            "properties": {
              "reviewStatus": {
                "enum": [
                  "draft",
                  "in-review",
                  "approved"
                ]
              },
              "headline": {
                "type": "string",
                "minLength": 1
              },
              "stop": {
                "type": "string",
                "minLength": 1
              },
              "triageIntro": {
                "type": "string",
                "minLength": 1
              },
              "triage": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "ifYes": {
                "type": "string",
                "minLength": 1
              },
              "ifNo": {
                "type": "string",
                "minLength": 1
              },
              "holdingIntro": {
                "type": "string",
                "minLength": 1
              },
              "holding": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
