{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SayWotNow prep.json",
  "type": "object",
  "required": [
    "contentVersion",
    "lastReviewed",
    "title",
    "intro",
    "groups",
    "labels",
    "cards"
  ],
  "additionalProperties": false,
  "properties": {
    "contentVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lastReviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "intro": {
      "type": "string",
      "minLength": 1
    },
    "groups": {
      "type": "object",
      "required": [
        "meetings",
        "conversations"
      ],
      "additionalProperties": false,
      "properties": {
        "meetings": {
          "type": "string",
          "minLength": 1
        },
        "conversations": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "labels": {
      "type": "object",
      "required": [
        "ask",
        "avoid",
        "remember"
      ],
      "additionalProperties": false,
      "properties": {
        "ask": {
          "type": "string",
          "minLength": 1
        },
        "avoid": {
          "type": "string",
          "minLength": 1
        },
        "remember": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "target",
          "ask",
          "avoid"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^P-[A-Za-z0-9]{2,12}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "object",
            "required": [
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "oneToOne",
                  "template",
                  "guide"
                ]
              },
              "id": {
                "type": "string"
              }
            }
          },
          "ask": {
            "description": "Exactly three questions.",
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "avoid": {
            "type": "string",
            "minLength": 1
          },
          "remember": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
