{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SayWotNow tools.json",
  "type": "object",
  "required": [
    "contentVersion",
    "lastEdited",
    "review",
    "tools"
  ],
  "additionalProperties": false,
  "properties": {
    "contentVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lastEdited": {
      "description": "When the file was last edited. This is not a review date.",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "review": {
      "description": "Review status (P0.4). Never mark approved without a real, named reviewer and date.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jurisdiction",
        "reviewStatus",
        "reviewedBy",
        "reviewedOn",
        "nextReviewOn"
      ],
      "properties": {
        "jurisdiction": {
          "enum": [
            "UK",
            "general"
          ]
        },
        "reviewStatus": {
          "enum": [
            "draft",
            "in-review",
            "approved"
          ]
        },
        "reviewedBy": {
          "description": "Name and qualification of the reviewer, or null"
        },
        "reviewedOn": {
          "description": "YYYY-MM-DD or null"
        },
        "nextReviewOn": {
          "description": "YYYY-MM-DD or null"
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "icon",
          "keywords",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "icon": {
            "type": "string",
            "minLength": 1
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "enum": [
              "ready"
            ]
          },
          "howItWorks": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "noteLevel": {
            "enum": [
              1,
              2,
              3
            ]
          },
          "noteFirst": {
            "type": "boolean"
          },
          "placeholders": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "nextLine": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "situation",
                "behaviour",
                "impact"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "situation": {
                  "type": "string",
                  "minLength": 1
                },
                "behaviour": {
                  "type": "string",
                  "minLength": 1
                },
                "impact": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "ukOnly": {
            "description": "Shows the 'UK rules' label (P0.4).",
            "type": "boolean"
          }
        }
      }
    }
  }
}
