{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SayWotNow reactions.json",
  "type": "object",
  "required": [
    "contentVersion",
    "lastReviewed",
    "title",
    "intro",
    "reactions"
  ],
  "additionalProperties": false,
  "properties": {
    "contentVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lastReviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "intro": {
      "type": "string",
      "minLength": 1
    },
    "reactions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "ifThey",
          "youCould"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R\\d{2}$"
          },
          "ifThey": {
            "type": "string",
            "minLength": 1
          },
          "youCould": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}