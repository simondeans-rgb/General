{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SayWotNow reactions.json",
  "type": "object",
  "required": [
    "contentVersion",
    "lastEdited",
    "review",
    "title",
    "intro",
    "reactions"
  ],
  "additionalProperties": false,
  "properties": {
    "contentVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lastEdited": {
      "description": "When the file was last edited. This is not a review date.",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "review": {
      "description": "Review status (P0.4). Never mark approved without a real, named reviewer and date.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jurisdiction",
        "reviewStatus",
        "reviewedBy",
        "reviewedOn",
        "nextReviewOn"
      ],
      "properties": {
        "jurisdiction": {
          "enum": [
            "UK",
            "general"
          ]
        },
        "reviewStatus": {
          "enum": [
            "draft",
            "in-review",
            "approved"
          ]
        },
        "reviewedBy": {
          "description": "Name and qualification of the reviewer, or null"
        },
        "reviewedOn": {
          "description": "YYYY-MM-DD or null"
        },
        "nextReviewOn": {
          "description": "YYYY-MM-DD or null"
        }
      }
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "intro": {
      "type": "string",
      "minLength": 1
    },
    "reactions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "ifThey",
          "youCould"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R\\d{2}$"
          },
          "ifThey": {
            "type": "string",
            "minLength": 1
          },
          "youCould": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
