{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SayWotNow interview.json (ACTED library)",
  "type": "object",
  "required": [
    "contentVersion",
    "lastReviewed",
    "libraryVersion",
    "methodology",
    "levels",
    "dimensions",
    "competencies",
    "ratingScale",
    "guidance"
  ],
  "additionalProperties": false,
  "properties": {
    "contentVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lastReviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "libraryVersion": {
      "type": "string",
      "minLength": 1
    },
    "methodology": {
      "type": "object",
      "required": [
        "name",
        "headline",
        "intro"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "headline": {
          "type": "string",
          "minLength": 1
        },
        "intro": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "colour",
          "good",
          "watchOuts"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "colour": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "good": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "watchOuts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "competencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "dimension",
          "definition",
          "questions"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "dimension": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "questions": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "id",
                "level",
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                },
                "level": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "ratingScale": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "value",
          "label",
          "short",
          "meaning"
        ],
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "short": {
            "type": "string",
            "minLength": 1
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "maxItems": 5
    },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "howToUse",
        "star",
        "evaluation",
        "decisions",
        "competencyStep",
        "coverageAdvice",
        "coverageComplete",
        "questionStep",
        "panelHelp"
      ],
      "properties": {
        "howToUse": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "star": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": [
              "label",
              "pack",
              "live"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "pack": {
                "type": "string",
                "minLength": 1
              },
              "live": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "maxItems": 4
        },
        "evaluation": {
          "type": "string",
          "minLength": 1
        },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "competencyStep": {
          "type": "string",
          "minLength": 1
        },
        "coverageAdvice": {
          "type": "string",
          "minLength": 1
        },
        "coverageComplete": {
          "type": "string",
          "minLength": 1
        },
        "questionStep": {
          "type": "string",
          "minLength": 1
        },
        "panelHelp": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
