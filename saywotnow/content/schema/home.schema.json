{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SayWotNow home.json",
  "type": "object",
  "required": [
    "contentVersion",
    "lastEdited",
    "review",
    "sectionTitle",
    "favouritesTitle",
    "favouritesHint",
    "tiles"
  ],
  "additionalProperties": false,
  "properties": {
    "contentVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lastEdited": {
      "description": "When the file was last edited. This is not a review date.",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "review": {
      "description": "Review status (P0.4). Never mark approved without a real, named reviewer and date.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jurisdiction",
        "reviewStatus",
        "reviewedBy",
        "reviewedOn",
        "nextReviewOn"
      ],
      "properties": {
        "jurisdiction": {
          "enum": [
            "UK",
            "general"
          ]
        },
        "reviewStatus": {
          "enum": [
            "draft",
            "in-review",
            "approved"
          ]
        },
        "reviewedBy": {
          "description": "Name and qualification of the reviewer, or null"
        },
        "reviewedOn": {
          "description": "YYYY-MM-DD or null"
        },
        "nextReviewOn": {
          "description": "YYYY-MM-DD or null"
        }
      }
    },
    "sectionTitle": {
      "type": "string",
      "minLength": 1
    },
    "favouritesTitle": {
      "type": "string",
      "minLength": 1
    },
    "favouritesHint": {
      "type": "string",
      "minLength": 1
    },
    "tiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "icon",
          "target"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "icon": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "object",
            "required": [
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "oneToOne",
                  "template",
                  "guide",
                  "tool",
                  "screen"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
