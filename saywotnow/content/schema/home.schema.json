{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SayWotNow home.json",
  "type": "object",
  "required": [
    "contentVersion",
    "lastReviewed",
    "sectionTitle",
    "favouritesTitle",
    "favouritesHint",
    "tiles"
  ],
  "additionalProperties": false,
  "properties": {
    "contentVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lastReviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sectionTitle": {
      "type": "string",
      "minLength": 1
    },
    "favouritesTitle": {
      "type": "string",
      "minLength": 1
    },
    "favouritesHint": {
      "type": "string",
      "minLength": 1
    },
    "tiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "icon",
          "target"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "icon": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "object",
            "required": [
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "oneToOne",
                  "template",
                  "guide",
                  "tool",
                  "screen"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}