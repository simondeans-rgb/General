{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SayWotNow pages.json",
  "type": "object",
  "required": [
    "contentVersion",
    "lastEdited",
    "review",
    "appName",
    "tagline",
    "supportEmail",
    "onboarding",
    "disclaimer",
    "privacy",
    "about",
    "contentInfo",
    "descriptor",
    "privacyLine"
  ],
  "additionalProperties": false,
  "properties": {
    "contentVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lastEdited": {
      "description": "When the file was last edited. This is not a review date.",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "review": {
      "description": "Review status (P0.4). Never mark approved without a real, named reviewer and date.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jurisdiction",
        "reviewStatus",
        "reviewedBy",
        "reviewedOn",
        "nextReviewOn"
      ],
      "properties": {
        "jurisdiction": {
          "enum": [
            "UK",
            "general"
          ]
        },
        "reviewStatus": {
          "enum": [
            "draft",
            "in-review",
            "approved"
          ]
        },
        "reviewedBy": {
          "description": "Name and qualification of the reviewer, or null"
        },
        "reviewedOn": {
          "description": "YYYY-MM-DD or null"
        },
        "nextReviewOn": {
          "description": "YYYY-MM-DD or null"
        }
      }
    },
    "appName": {
      "type": "string",
      "minLength": 1
    },
    "tagline": {
      "type": "string",
      "minLength": 1
    },
    "supportEmail": {
      "type": "string"
    },
    "onboardingNote": {
      "type": "string",
      "minLength": 1
    },
    "onboarding": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "heading",
          "text",
          "art"
        ],
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "art": {
            "enum": [
              "pocket",
              "lock",
              "phone"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "disclaimer": {
      "type": "object",
      "required": [
        "version",
        "title",
        "text"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "required": [
        "title",
        "text"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "about": {
      "type": "object",
      "required": [
        "title",
        "text"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "contentInfo": {
      "type": "object",
      "required": [
        "title",
        "text"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "descriptor": {
      "type": "string",
      "minLength": 1
    },
    "privacyLine": {
      "type": "string",
      "minLength": 1
    }
  }
}
