{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SayWotNow timezones.json",
  "type": "object",
  "required": [
    "contentVersion",
    "lastReviewed",
    "defaults",
    "places"
  ],
  "additionalProperties": false,
  "properties": {
    "contentVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lastReviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "defaults": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "places": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "city",
          "country",
          "tz"
        ],
        "additionalProperties": false,
        "properties": {
          "city": {
            "type": "string",
            "minLength": 1
          },
          "country": {
            "type": "string",
            "minLength": 1
          },
          "tz": {
            "type": "string",
            "minLength": 1
          },
          "abbr": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}