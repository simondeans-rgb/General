{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SayWotNow templates.json",
  "type": "object",
  "required": [
    "contentVersion",
    "lastEdited",
    "review",
    "header",
    "email",
    "ratingScales",
    "templates"
  ],
  "additionalProperties": false,
  "properties": {
    "contentVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lastEdited": {
      "description": "When the file was last edited. This is not a review date.",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "review": {
      "description": "Review status (P0.4). Never mark approved without a real, named reviewer and date.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jurisdiction",
        "reviewStatus",
        "reviewedBy",
        "reviewedOn",
        "nextReviewOn"
      ],
      "properties": {
        "jurisdiction": {
          "enum": [
            "UK",
            "general"
          ]
        },
        "reviewStatus": {
          "enum": [
            "draft",
            "in-review",
            "approved"
          ]
        },
        "reviewedBy": {
          "description": "Name and qualification of the reviewer, or null"
        },
        "reviewedOn": {
          "description": "YYYY-MM-DD or null"
        },
        "nextReviewOn": {
          "description": "YYYY-MM-DD or null"
        }
      }
    },
    "header": {
      "type": "object",
      "required": [
        "title",
        "fields"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      },
      "additionalProperties": false
    },
    "email": {
      "type": "object",
      "required": [
        "greeting",
        "signOff",
        "footer"
      ],
      "properties": {
        "greeting": {
          "type": "string",
          "minLength": 1
        },
        "signOff": {
          "type": "string",
          "minLength": 1
        },
        "footer": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "ratingScales": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/template"
      }
    }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "equals": {
          "type": "string"
        },
        "in": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notEmpty": {
          "type": "boolean"
        },
        "any": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "all": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "not": {
          "$ref": "#/$defs/condition"
        }
      },
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "required": [
        "id",
        "label",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "shortText",
            "longText",
            "email",
            "date",
            "dateRange",
            "number",
            "rating",
            "singleChoice",
            "multiChoice",
            "checklist",
            "actionList",
            "repeater"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "requiredIf": {
          "$ref": "#/$defs/condition"
        },
        "showIf": {
          "$ref": "#/$defs/condition"
        },
        "helper": {
          "type": "string",
          "minLength": 1
        },
        "placeholder": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scale": {
          "type": "string",
          "minLength": 1
        },
        "default": {
          "enum": [
            "today"
          ]
        },
        "min": {
          "type": "object",
          "required": [
            "field"
          ],
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "itemLabel": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "primary": {
          "type": "boolean"
        },
        "emailLabel": {
          "type": "boolean"
        },
        "emailLabelText": {
          "type": "string",
          "minLength": 1
        },
        "toggle": {
          "type": "string",
          "minLength": 1
        },
        "inEmail": {
          "type": "boolean"
        },
        "hideInShort": {
          "type": "boolean"
        },
        "sensitive": {
          "description": "Wellbeing or health detail (P0.5): left out of emails, copies and shares unless the manager switches it on for that email.",
          "type": "boolean"
        }
      }
    },
    "section": {
      "type": "object",
      "required": [
        "id",
        "title",
        "fields"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "optional": {
          "type": "boolean"
        },
        "notice": {
          "type": "string",
          "minLength": 1
        },
        "emailHeading": {
          "type": "boolean"
        },
        "showIf": {
          "$ref": "#/$defs/condition"
        },
        "hideInShort": {
          "type": "boolean"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      }
    },
    "template": {
      "type": "object",
      "required": [
        "id",
        "name",
        "purpose",
        "whenToUse",
        "length",
        "keywords",
        "subject",
        "intro",
        "sections"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^T\\d{2}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "whenToUse": {
          "type": "string",
          "minLength": 1
        },
        "length": {
          "type": "string",
          "minLength": 1
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "listed": {
          "type": "boolean"
        },
        "pair": {
          "type": "object",
          "required": [
            "full",
            "quick"
          ],
          "properties": {
            "full": {
              "type": "string",
              "minLength": 1
            },
            "quick": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "intro": {
          "type": "string",
          "minLength": 1
        },
        "closing": {
          "type": "string",
          "minLength": 1
        },
        "allowHrCc": {
          "type": "boolean"
        },
        "notices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "level",
              "text"
            ],
            "properties": {
              "level": {
                "enum": [
                  0,
                  1,
                  2,
                  3
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "level",
              "when",
              "text"
            ],
            "properties": {
              "level": {
                "enum": [
                  1,
                  2,
                  3
                ]
              },
              "when": {
                "$ref": "#/$defs/condition"
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "contactHr": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "sendRules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "when",
              "mode"
            ],
            "properties": {
              "when": {
                "$ref": "#/$defs/condition"
              },
              "mode": {
                "enum": [
                  "hrOnly"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  }
}
