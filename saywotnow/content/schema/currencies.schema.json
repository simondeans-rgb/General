{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SayWotNow currencies.json",
  "type": "object",
  "required": [
    "contentVersion",
    "lastEdited",
    "review",
    "source",
    "defaults",
    "countryCurrency",
    "bundledRates"
  ],
  "additionalProperties": false,
  "properties": {
    "contentVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "lastEdited": {
      "description": "When the file was last edited. This is not a review date.",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "review": {
      "description": "Review status (P0.4). Never mark approved without a real, named reviewer and date.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jurisdiction",
        "reviewStatus",
        "reviewedBy",
        "reviewedOn",
        "nextReviewOn"
      ],
      "properties": {
        "jurisdiction": {
          "enum": [
            "UK",
            "general"
          ]
        },
        "reviewStatus": {
          "enum": [
            "draft",
            "in-review",
            "approved"
          ]
        },
        "reviewedBy": {
          "description": "Name and qualification of the reviewer, or null"
        },
        "reviewedOn": {
          "description": "YYYY-MM-DD or null"
        },
        "nextReviewOn": {
          "description": "YYYY-MM-DD or null"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "name",
        "url",
        "endpoint",
        "attribution"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "defaults": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "pattern": "^[^|]+\\|[^|]+$"
      }
    },
    "countryCurrency": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Z]{3}$"
      }
    },
    "bundledRates": {
      "type": "object",
      "required": [
        "base",
        "asOf",
        "rates"
      ],
      "additionalProperties": false,
      "properties": {
        "base": {
          "enum": [
            "USD"
          ]
        },
        "asOf": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "rates": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}
